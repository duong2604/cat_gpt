@startuml D06-uc-khai-thac
!include _style.iuml
left to right direction

actor "Nhân viên" as NV
actor "Dịch vụ AI\n(LLM, embedding)" as AI

rectangle "Module 4 — Khai thác thông tin từ tài liệu" {
  usecase "UC24. Chọn phạm vi\ntài liệu (≤ 5)" as U24
  usecase "UC25. Hỏi đáp dựa\ntrên tài liệu" as U25
  usecase "UC26. Xem trích dẫn\nnguồn" as U26
  usecase "UC27. Tóm tắt tài liệu" as U27
}

NV -- U25
NV -- U27
U25 ..> U24 : <<include>>
