' Kiểu chung cho mọi sơ đồ báo cáo (render: java -jar plantuml.jar -tpng -charset UTF-8)
' Bảng màu trung tính, nét đen/xám để in A4 rõ ràng.
!pragma layout smetana
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 16
skinparam dpi 170
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #222222
skinparam ArrowFontSize 14
skinparam roundCorner 8
skinparam usecase {
  BackgroundColor #F7F7F7
  BorderColor #333333
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #222222
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #555555
}
skinparam component {
  BackgroundColor #F7F7F7
  BorderColor #333333
}
skinparam database {
  BackgroundColor #EFEFEF
  BorderColor #333333
}
skinparam queue {
  BackgroundColor #EFEFEF
  BorderColor #333333
}
skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam sequence {
  ParticipantBackgroundColor #F7F7F7
  ParticipantBorderColor #333333
  LifeLineBorderColor #888888
  ActorBorderColor #222222
  GroupBorderColor #555555
}
skinparam activity {
  BackgroundColor #F7F7F7
  BorderColor #333333
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #333333
}
skinparam swimlane {
  BorderColor #555555
  TitleFontSize 16
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  HeaderBackgroundColor #EDEDED
}
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam noteBackgroundColor #FAFAFA
skinparam noteBorderColor #777777
