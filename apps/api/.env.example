# ===== Ứng dụng =====
NODE_ENV=development
PORT=4000

# ===== MongoDB =====
# MongoDB Atlas (M0 free): lấy chuỗi kết nối trong Atlas > Connect > Drivers
# Nhớ đặt tên database ở sau dấu "/" (ví dụ cat_gpt)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cat_gpt?retryWrites=true&w=majority

# ===== Xác thực =====
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự. Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Đặt true khi chạy HTTPS (production)
COOKIE_SECURE=false

# ===== Mạng =====
# Để trống nếu FE gọi API qua proxy cùng origin (Next.js rewrites / Nginx)
CORS_ORIGINS=
TRUST_PROXY=loopback

# ===== Khác =====
# demo (mặc định, bản 20/11), staff (thử nội bộ — ẩn Chat, Tài liệu), production (triển khai thật: cần NODE_ENV=production, LLM_PROVIDER=openai, COOKIE_SECURE=true, secret/mật khẩu không phải giá trị mẫu)
RELEASE_MODE=demo
# Không đặt (để comment) → theo RELEASE_MODE: bật ở demo, tắt ở staff và production. Bỏ comment để tự đặt.
# SWAGGER_ENABLED=
# DNS cho tiến trình API (phân tách bằng dấu phẩy). Để trống = DNS hệ thống.
# Máy có DNS hệ thống là 127.0.0.1 cần đặt, ví dụ: DNS_SERVERS=8.8.8.8,1.1.1.1
DNS_SERVERS=
UPLOAD_DIR=uploads

# ===== Tài khoản admin mặc định (chỉ tạo khi hệ thống chưa có admin) =====
ADMIN_EMAIL=admin@catgpt.local
ADMIN_PASSWORD=Admin@123
ADMIN_FULL_NAME=Administrator

# ===== Trợ lý AI =====
# mock (mặc định — demo, test local, không gọi mạng) | openai (Responses API, streaming, store: false)
LLM_PROVIDER=mock
# Để trống → mock-1 (mock) hoặc gpt-5.4-mini (openai)
# LLM_MODEL=
# Bắt buộc khi LLM_PROVIDER=openai. Chỉ đặt trong .env trên máy chủ, không commit, không ghi log.
OPENAI_API_KEY=
# Giới hạn token đầu ra mỗi câu trả lời (mặc định 1000). Chạm giới hạn → giữ phần đã sinh, nhãn "bị cắt"
LLM_MAX_OUTPUT_TOKENS=1000
# Ngân sách token (ước lượng) cho lịch sử gửi lại mỗi lượt (mặc định 4000)
LLM_HISTORY_TOKEN_BUDGET=4000
# Để trống sẽ dùng system prompt mặc định
# LLM_SYSTEM_PROMPT=

# ===== Hạ tầng dev (Docker: docker compose up -d) =====
REDIS_HOST=localhost
REDIS_PORT=6379
# Tách dữ liệu hàng đợi giữa các phiên dev
BULLMQ_PREFIX=cat-gpt
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
# Giá trị thật chỉ trong .env và docker-compose.yml (chạy `docker compose --env-file apps/api/.env up -d`)
MINIO_ACCESS_KEY=example_access_key
MINIO_SECRET_KEY=example_secret_key
# Riêng tư — không bật chính sách public
MINIO_BUCKET=cat-gpt-dev
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_chunks

# ===== Tài liệu (SE-011) =====
EMBEDDING_MODEL=text-embedding-3-small
DOCUMENT_MAX_SIZE_MB=20
DOCUMENT_MAX_CHUNKS=500
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=150
DOCUMENT_JOB_ATTEMPTS=3
DOCUMENT_MAX_PDF_PAGES=2000
DOCUMENT_MAX_DOCX_XML_MB=50
RAG_TOP_K=5
RAG_MIN_SCORE=
RAG_MAX_DOCUMENTS=5
RAG_SUMMARY_GROUP_CHARS=12000
