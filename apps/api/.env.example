# ===== Ứng dụng =====
NODE_ENV=development
PORT=4000

# ===== MongoDB =====
# MongoDB Atlas (M0 free): lấy chuỗi kết nối trong Atlas > Connect > Drivers
# Nhớ đặt tên database ở sau dấu "/" (ví dụ cat_gpt)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cat_gpt?retryWrites=true&w=majority

# ===== Xác thực =====
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự. Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Đặt true khi chạy HTTPS (production)
COOKIE_SECURE=false

# ===== Mạng =====
# Để trống nếu FE gọi API qua proxy cùng origin (Next.js rewrites / Nginx)
CORS_ORIGINS=
TRUST_PROXY=loopback

# ===== Khác =====
SWAGGER_ENABLED=true
UPLOAD_DIR=uploads

# ===== Tài khoản admin mặc định (chỉ tạo khi hệ thống chưa có admin) =====
ADMIN_EMAIL=admin@catgpt.local
ADMIN_PASSWORD=Admin@123
ADMIN_FULL_NAME=Administrator

# ===== Trợ lý AI =====
# Hiện dùng bản giả lập (mock). Khi có LLM thật sẽ bổ sung LLM_BASE_URL / LLM_API_KEY.
LLM_MODEL=mock-1
# Để trống sẽ dùng system prompt mặc định
# LLM_SYSTEM_PROMPT=
